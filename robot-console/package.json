{
  "name": "kindervoice-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/seed-science-on-build.mjs && node scripts/seed-qualification-on-build.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "seed": "node scripts/prepare-assets.mjs && node prisma/seed.mjs",
    "seed:science": "node scripts/seed-science-knowledge.mjs",
    "upload:science-stories": "node scripts/upload-science-story-videos.mjs",
    "import:science": "node scripts/import-local-science-materials.mjs",
    "export:dify": "node scripts/export-dify-teaching-knowledge.mjs",
    "attach:science-step-images": "node scripts/attach-local-experiment-step-images.mjs",
    "attach:science-videos": "node scripts/attach-experiment-video-resources.mjs",
    "test:science": "node --no-warnings --test src/lib/science-navigation.test.mjs scripts/science-source-layout.test.mjs scripts/attach-experiment-video-resources.test.mjs scripts/science-catalog.contract.test.mjs scripts/science-poem-covers.test.mjs src/components/ScienceLab.hero.contract.test.mjs scripts/seed-science-on-build.test.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "jose": "^6.2.3",
    "lucide-react": "^0.561.0",
    "mammoth": "^1.12.0",
    "motion": "^12.42.2",
    "next": "16.2.9",
    "ogl": "^1.0.11",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.6.0",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.10.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.9",
    "prisma": "^6.16.3",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
