{
  "name": "kindervoice-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/seed-science-on-build.mjs && node scripts/seed-qualification-on-build.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "seed": "node scripts/prepare-assets.mjs && node prisma/seed.mjs",
    "seed:science": "node scripts/seed-science-knowledge.mjs",
    "sync:science-media": "node scripts/sync-science-media.mjs",
    "upload:science-stories": "node scripts/upload-science-story-videos.mjs",
