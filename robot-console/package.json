    "attach:science-step-images": "node scripts/attach-local-experiment-step-images.mjs",
    "attach:science-videos": "node scripts/attach-experiment-video-resources.mjs",
    "upload:incoming-experiment-videos": "node scripts/upload-incoming-experiment-videos.mjs",
    "attach:incoming-static-video": "node scripts/attach-incoming-static-video.mjs",
    "test:science": "node --no-warnings --test src/lib/science-navigation.test.mjs scripts/science-source-layout.test.mjs scripts/attach-experiment-video-resources.test.mjs scripts/science-catalog.contract.test.mjs scripts/science-poem-covers.test.mjs src/components/ScienceLab.hero.contract.test.mjs scripts/seed-science-on-build.test.mjs"
  },
