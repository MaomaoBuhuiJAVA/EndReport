# Vercel Postgres / Neon / Supabase PostgreSQL URL.
# In Vercel, map DATABASE_URL to the Postgres connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Required for login session signing. Use a long random string in production.
AUTH_SECRET="replace_with_a_long_random_secret"

# Server-side only. Never expose this with NEXT_PUBLIC_.
DEEPSEEK_API_KEY="your_deepseek_api_key_here"

# Optional: set if you want to switch endpoints later.
DEEPSEEK_API_URL="https://api.deepseek.com/chat/completions"

# Server-side only. Used by the Xunfei TTS WebSocket, never with NEXT_PUBLIC_.
XFYUN_APP_ID=""
XFYUN_API_PASSWORD=""

# Optional legacy signing credentials when APIPassword auth is not enabled.
XFYUN_API_KEY=""
XFYUN_API_SECRET=""

# Optional. The voice configured in the Xunfei console.
XFYUN_TTS_VOICE="x4_doudou"
