SMS_ACCESS_KEY_ID=""
SMS_ACCESS_KEY_SECRET=""
SMS_SECURITY_TOKEN=""
# Independent random secret, at least 32 characters; never expose it to the browser.
SMS_VERIFICATION_SECRET=""
SMS_CODE_PARAMETER="code"
SMS_TEMPLATE_LOGIN="SMS_51215901"
SMS_TEMPLATE_REGISTER="SMS_512585836"
SMS_TEMPLATE_RESET_PASSWORD="SMS_512685888"
SMS_TEMPLATE_CHANGE_PHONE="SMS_512520955"
DEVICE_HEARTBEAT_SECRET="replace_with_a_device_secret"

# One server-side Qwen key for text, vision, generated images and speech.
# Reuses the existing speech key; DASHSCOPE_API_KEY is an alternative.
QWEN_TTS_API_KEY=""
DASHSCOPE_API_KEY=""
QWEN_API_BASE_URL="https://maas.qianwenaiapi.com/api/v1"
QWEN_TEXT_MODEL="qwen3.5-plus"
QWEN_VOICE_MODEL="qwen-flash"
QWEN_VISION_MODEL="qwen3-vl-flash"
QWEN_IMAGE_MODEL="qwen-image"
QWEN_TTS_MODEL="qwen-audio-3.0-tts-flash"
QWEN_TTS_VOICE="longpaopao_v3.6"

# Private generated documents on persistent server storage.
AI_ARTIFACT_DIR=""
AI_ARTIFACT_SECRET=""

# Existing private OSS bucket. No additional hosted-storage token is needed.
OSS_BUCKET="guokemeitiku"
OSS_REGION="oss-cn-hangzhou"
ALIBABA_CLOUD_ACCESS_KEY_ID=""
ALIBABA_CLOUD_ACCESS_KEY_SECRET=""
